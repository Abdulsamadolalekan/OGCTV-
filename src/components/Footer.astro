---
import { FOOTER_SECTIONS, SITE } from '../lib/config';
---
<section class="cta-band"><div class="container cta-grid"><div><h2>See something we should know?</h2><p>Send a tip, document or community story to the OGCTV newsroom. Please tell us what happened, where and when.</p></div><div class="cta-action"><a class="button" href={`https://wa.me/${SITE.whatsappIntl}?text=${encodeURIComponent('Hello OGCTV newsroom, I have a news tip: ')}`} target="_blank" rel="noopener">WhatsApp {SITE.whatsapp}</a><a class="button secondary" href="/contact#tip">Other ways to contact</a></div></div></section>
<footer class="site-footer"><div class="container"><div class="footer-top"><div class="footer-brand"><a href="/" class="footer-logo" aria-label="OGCTV home"><img src={SITE.logo} width={SITE.logoWidth} height={SITE.logoHeight} alt={`${SITE.name} — ${SITE.tagline}`} loading="lazy" decoding="async" /></a><p>{SITE.tagline} Local news, public affairs and original video for Ogun State and surrounding communities.</p><p><strong>Newsroom WhatsApp</strong><br><a href={`https://wa.me/${SITE.whatsappIntl}`}>{SITE.whatsapp}</a></p></div><div class="footer-links">{FOOTER_SECTIONS.map(s=><section><h2>{s.title}</h2>{s.links.map(l=><a href={l.href}>{l.label}</a>)}</section>)}</div></div><div class="footer-bottom"><span>© {new Date().getFullYear()} OGCTV. All rights reserved.</span><span>Built for factual, accountable local journalism.</span></div></div></footer>
