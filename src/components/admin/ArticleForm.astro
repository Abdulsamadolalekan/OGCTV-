---
import type {FullArticle,Category,Author} from '../../lib/db'; import {PROGRAMMES} from '../../lib/queries'; import type {Errors} from '../../lib/validate';
interface Props{article?:FullArticle;categories:Category[];authors:Author[];errors?:Errors;values?:Record<string,unknown>}
const {article,categories,authors,errors={},values={}}=Astro.props; const v=(key:string,fallback:any='')=>values[key]??(article as any)?.[key]??fallback; const checked=(key:string)=>{const x=v(key,false);return x===true||x===1||x==='on'||x==='1'}; const kind=String(v('kind',Astro.url.searchParams.get('kind')==='video'?'video':'story'));
---
<div class="editor-grid"><div><div class="panel" style="margin-top:0"><div class="field"><label for="title">Headline *</label><input id="title" name="title" value={v('title')} maxlength="200" required autofocus/>{errors.title&&<span class="errors">{errors.title}</span>}</div><div class="field"><label for="deck">Deck / standfirst</label><textarea id="deck" name="deck" maxlength="400" style="min-height:95px">{v('deck')}</textarea><small>One or two sentences that add context without repeating the headline.</small></div><div class="field"><label for="body">Article body (Markdown) *</label><textarea class="body" id="body" name="body">{v('body')}</textarea>{errors.body&&<span class="errors">{errors.body}</span>}<small>Use ## for section headings, **bold**, [link text](https://…), and ![alt](/media/image.jpg "caption").</small></div></div><div class="panel"><h2>Hero media</h2><div class="field"><label for="image">Image path</label><input id="image" name="image" value={v('image')} placeholder="/media/filename.jpg or /seed-media/example.svg"/>{errors.image&&<span class="errors">{errors.image}</span>}<small>Upload in <a href="/admin/media" target="_blank">Media</a>, then paste its path.</small></div><div class="field"><label for="image_alt">Image alt text</label><input id="image_alt" name="image_alt" value={v('image_alt')} maxlength="300"/></div><div class="field"><label for="image_caption">Caption</label><input id="image_caption" name="image_caption" value={v('image_caption')} maxlength="300"/></div><div class="field"><label for="image_credit">Credit</label><input id="image_credit" name="image_credit" value={v('image_credit')} maxlength="200"/></div></div><div class="panel"><h2>Video</h2><div class="field"><label for="video_url">YouTube or Vimeo URL</label><input id="video_url" name="video_url" type="url" value={v('video_url')} placeholder="https://www.youtube.com/watch?v=…"/>{errors.video_url&&<span class="errors">{errors.video_url}</span>}</div><div class="field"><label for="video_duration">Duration</label><input id="video_duration" name="video_duration" value={v('video_duration')} placeholder="04:18"/>{errors.video_duration&&<span class="errors">{errors.video_duration}</span>}</div><div class="field"><label for="programme">Programme</label><select id="programme" name="programme"><option value="">None</option>{PROGRAMMES.map(p=><option value={p.slug} selected={v('programme')===p.slug}>{p.name}</option>)}</select></div></div></div><aside><div class="panel" style="margin-top:0"><h2>Publish</h2><div class="field"><label for="status">Status</label><select name="status" id="status"><option value="draft" selected={v('status','draft')==='draft'}>Draft</option><option value="published" selected={v('status')==='published'}>Published</option><option value="archived" selected={v('status')==='archived'}>Archived</option></select></div><div class="field"><label for="kind">Content type</label><select name="kind" id="kind"><option value="story" selected={kind==='story'}>Story</option><option value="video" selected={kind==='video'}>Video</option></select></div><div class="actions"><button class="btn">{article?'Save changes':'Create item'}</button><a class="btn secondary" href="/admin/articles">Cancel</a></div></div><div class="panel"><h2>Organisation</h2><div class="field"><label for="category_id">Category *</label><select id="category_id" name="category_id" required><option value="">Choose…</option>{categories.map(c=><option value={c.id} selected={Number(v('category_id'))===c.id}>{c.name}</option>)}</select>{errors.category_id&&<span class="errors">{errors.category_id}</span>}</div><div class="field"><label for="author_id">Author / byline *</label><select id="author_id" name="author_id" required>{authors.map(a=><option value={a.id} selected={Number(v('author_id',authors[0]?.id))===a.id}>{a.name}</option>)}</select>{errors.author_id&&<span class="errors">{errors.author_id}</span>}</div><div class="field"><label for="slug">URL slug</label><input id="slug" name="slug" value={v('slug')} placeholder="Generated from headline"/></div><div class="field"><label for="tags">Tags</label><input id="tags" name="tags" value={v('tags')} placeholder="Abeokuta, Markets, Explainer"/></div></div><div class="panel"><h2>Placement</h2><label class="check"><input type="checkbox" name="featured" checked={checked('featured')}/> <span><strong>Featured</strong><br>Eligible for homepage lead.</span></label><label class="check"><input type="checkbox" name="trending" checked={checked('trending')}/> <span><strong>Trending</strong><br>Show in trending lists.</span></label><label class="check"><input type="checkbox" name="breaking" checked={checked('breaking')}/> <span><strong>Breaking</strong><br>Use only for verified urgent news.</span></label>{checked('is_sample')&&<label class="check"><input type="checkbox" name="is_sample" checked/> <span><strong>Sample content</strong><br>Keep the public warning label.</span></label>}</div></aside></div>
