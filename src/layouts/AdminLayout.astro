---
import '../styles/admin.css'; import type {SessionUser} from '../lib/auth';
interface Props{title:string;user?:SessionUser;message?:string;error?:string}
const {title,user=Astro.locals.user,message,error}=Astro.props;
---
<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="robots" content="noindex,nofollow"><title>{title} · OGCTV Newsroom</title><link rel="icon" href="/favicon.svg"></head><body><a class="admin-skip" href="#content">Skip to content</a>{user?<><aside class="admin-sidebar"><a class="admin-brand" href="/admin">OGCTV <small>NEWSROOM</small></a><nav><a href="/admin">Overview</a><a href="/admin/articles">Stories</a><a href="/admin/articles/new">New story</a><a href="/admin/articles/new?kind=video">New video</a><a href="/admin/categories">Categories</a><a href="/admin/authors">Authors</a><a href="/admin/media">Media</a><a href="/" target="_blank">View public site ↗</a></nav><form action="/admin/logout" method="post"><button class="logout">Sign out</button></form></aside><div class="admin-shell"><header class="admin-top"><span>{title}</span><span>{user.name} · {user.role}</span></header><main id="content" class="admin-content">{message&&<div class="notice success">{message}</div>}{error&&<div class="notice error">{error}</div>}<slot/></main></div></>:<main id="content" class="auth-shell">{message&&<div class="notice success">{message}</div>}{error&&<div class="notice error">{error}</div>}<slot/></main>}</body></html>
