---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../lib/config'; import {hasPublishedSampleContent} from '../lib/queries';
import '../styles/global.css';
interface Props { title?:string; description?:string; image?:string|null; canonical?:string; type?:'website'|'article'|'video.other'; published?:string|null; updated?:string|null; noindex?:boolean; jsonLd?:Record<string,unknown>|Record<string,unknown>[]; }
const { title, description=SITE.description, image, canonical, type='website', published, updated, noindex=false, jsonLd }=Astro.props;
const pageTitle=title?`${title} | OGCTV`:`OGCTV — ${SITE.tagline}`;
const url=canonical ?? new URL(Astro.url.pathname, SITE.url).toString();
const img=image?new URL(image,SITE.url).toString():undefined;
const socialImg=img ?? new URL(SITE.logoSocial,SITE.url).toString();
const socialAlt=img?`${pageTitle}`:`${SITE.name} — ${SITE.tagline}`; const showDemoNotice=SITE.demoContent&&hasPublishedSampleContent(); const effectiveNoindex=noindex||showDemoNotice;
---
<!doctype html><html lang="en-NG"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>{pageTitle}</title><meta name="description" content={description}><link rel="canonical" href={url}><link rel="icon" href={SITE.logoIcons.favicon32} type="image/png" sizes="32x32"><link rel="icon" href={SITE.logoIcons.favicon48} type="image/png" sizes="48x48"><link rel="apple-touch-icon" href={SITE.logoIcons.appleTouch180} sizes="180x180">{effectiveNoindex&&<meta name="robots" content="noindex,nofollow"/>}<meta property="og:site_name" content="OGCTV"><meta property="og:locale" content="en_NG"><meta property="og:type" content={type}><meta property="og:title" content={pageTitle}><meta property="og:description" content={description}><meta property="og:url" content={url}>{<meta property="og:image" content={socialImg}/>}{<meta property="og:image:secure_url" content={socialImg}/>}{<meta property="og:image:alt" content={socialAlt}/>}{!img&&<meta property="og:image:type" content="image/jpeg"/>}{!img&&<meta property="og:image:width" content={String(SITE.logoSocialWidth)}/>}{!img&&<meta property="og:image:height" content={String(SITE.logoSocialHeight)}/>}<meta name="twitter:card" content="summary_large_image"><meta name="twitter:title" content={pageTitle}><meta name="twitter:description" content={description}><meta name="twitter:image" content={socialImg}>{published&&<meta property="article:published_time" content={published}/>} {updated&&<meta property="article:modified_time" content={updated}/>}<link rel="alternate" type="application/rss+xml" title="OGCTV latest stories" href="/rss.xml">{jsonLd&&<script type="application/ld+json" set:html={JSON.stringify(jsonLd)}/>}<slot name="head" /></head><body><Header />{showDemoNotice&&<div class="demo-notice"><div class="container"><strong>Launch preview</strong><span>Stories marked “Sample” demonstrate the newsroom experience and do not describe current events.</span></div></div>}<main id="main-content"><slot /></main><Footer /><script is:inline src="/site.js"></script></body></html>
