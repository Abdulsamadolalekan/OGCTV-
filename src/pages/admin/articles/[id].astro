---
import AdminLayout from '../../../layouts/AdminLayout.astro'; import ArticleForm from '../../../components/admin/ArticleForm.astro'; import {getCategories,getAuthors,getArticleById,updateArticle} from '../../../lib/queries'; import {validateArticle,type Errors} from '../../../lib/validate'; import {originOk} from '../../../lib/auth';
const id=Number(Astro.params.id);let article=getArticleById(id);if(!article)Astro.response.status=404;const categories=getCategories(false),authors=getAuthors(false);let errors:Errors={};let values:Record<string,unknown>={};let error='';let message=Astro.url.searchParams.has('created')?'Content created successfully.':'';if(article&&Astro.request.method==='POST'){if(!originOk(Astro.request))error='Request origin could not be verified.';else{const f=await Astro.request.formData();values=Object.fromEntries(f.entries());const result=validateArticle(values,{categoryIds:new Set(categories.map(c=>c.id)),authorIds:new Set(authors.map(a=>a.id))});if(result.ok){updateArticle(id,result.value);article=getArticleById(id);message='Changes saved.';values={}}else errors=result.errors}}
---
<AdminLayout title={article?'Edit content':'Not found'} message={message} error={error}>{article?<><div class="page-title"><div><h1>Edit {article.kind}</h1><p>{article.title}</p></div><div class="actions"><a class="btn secondary" href={`/admin/preview/${article.id}`} target="_blank">Preview ↗</a>{article.status==='published'&&<a class="btn secondary" href={article.kind==='video'?`/tv/${article.slug}`:`/article/${article.slug}`} target="_blank">View live ↗</a>}</div></div>{Object.keys(errors).length>0&&<div class="notice error">Review the highlighted fields.</div>}<form method="post"><ArticleForm article={article} categories={categories} authors={authors} errors={errors} values={values}/></form></>:<div class="panel"><h1>Item not found</h1><a href="/admin/articles">Back to stories</a></div>}</AdminLayout>
