---
import AdminLayout from '../../../layouts/AdminLayout.astro'; import {listArticlesAdmin,deleteArticle} from '../../../lib/queries'; import {originOk} from '../../../lib/auth'; import {formatDateTime} from '../../../lib/utils';
let message=Astro.url.searchParams.has('created')?'Content created.':Astro.url.searchParams.has('updated')?'Changes saved.':'';let error='';if(Astro.request.method==='POST'){if(!originOk(Astro.request))error='Request origin failed.';else{const f=await Astro.request.formData();if(f.get('action')==='delete'){const id=Number(f.get('id'));if(deleteArticle(id))message='Item deleted permanently.';else error='Item not found.'}}}const status=(Astro.url.searchParams.get('status')||'all') as any;const kind=(Astro.url.searchParams.get('kind')||'all') as any;const q=Astro.url.searchParams.get('q')||'';const items=listArticlesAdmin({status,kind,q});
---
<AdminLayout title="Stories" message={message} error={error}><div class="page-title"><div><h1>Stories & video</h1><p>{items.length} item(s) in this view.</p></div><a class="btn" href="/admin/articles/new">Create story</a></div><form class="filters" method="get"><input name="q" value={q} placeholder="Search headlines"><select name="status"><option value="all">All statuses</option><option value="published" selected={status==='published'}>Published</option><option value="draft" selected={status==='draft'}>Drafts</option><option value="archived" selected={status==='archived'}>Archived</option></select><select name="kind"><option value="all">Stories + video</option><option value="story" selected={kind==='story'}>Stories</option><option value="video" selected={kind==='video'}>Video</option></select><button class="btn secondary">Filter</button></form><div class="table-wrap"><table><thead><tr><th>Headline</th><th>Status</th><th>Type</th><th>Category</th><th>Updated</th><th></th></tr></thead><tbody>{items.map(a=><tr><td><a href={`/admin/articles/${a.id}`}>{a.title}</a>{a.breaking===1&&<span class="status" style="color:var(--red)"> · Breaking</span>}{a.is_sample===1&&<span> · Sample</span>}</td><td><span class={`status ${a.status}`}>{a.status}</span></td><td>{a.kind}</td><td>{a.category_name}</td><td>{formatDateTime(a.updated_at)}</td><td><form method="post" onsubmit="return confirm('Permanently delete this item?')"><input type="hidden" name="action" value="delete"><input type="hidden" name="id" value={a.id}><button class="btn danger">Delete</button></form></td></tr>)}</tbody></table></div></AdminLayout>
