---
import AdminLayout from '../../../layouts/AdminLayout.astro'; import ArticleForm from '../../../components/admin/ArticleForm.astro'; import {getCategories,getAuthors,createArticle} from '../../../lib/queries'; import {validateArticle,type Errors} from '../../../lib/validate'; import {originOk} from '../../../lib/auth';
const categories=getCategories(false),authors=getAuthors(false);let errors:Errors={};let values:Record<string,unknown>={};let error='';if(Astro.request.method==='POST'){if(!originOk(Astro.request))error='Request origin could not be verified.';else{const f=await Astro.request.formData();values=Object.fromEntries(f.entries());const result=validateArticle(values,{categoryIds:new Set(categories.map(c=>c.id)),authorIds:new Set(authors.map(a=>a.id))});if(result.ok){const id=createArticle(result.value);return Astro.redirect(`/admin/articles/${id}?created=1`,303)}errors=result.errors}}
---
<AdminLayout title="Create content" error={error}><div class="page-title"><div><h1>New {Astro.url.searchParams.get('kind')==='video'?'video':'story'}</h1><p>Save a draft, preview it later, then publish.</p></div></div>{Object.keys(errors).length>0&&<div class="notice error">Review the highlighted fields.</div>}<form method="post"><ArticleForm categories={categories} authors={authors} errors={errors} values={values}/></form></AdminLayout>
