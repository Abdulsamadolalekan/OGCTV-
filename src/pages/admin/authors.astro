---
import AdminLayout from '../../layouts/AdminLayout.astro'; import {getAuthors,upsertAuthor} from '../../lib/queries'; import {originOk} from '../../lib/auth';
let message='',error='';if(Astro.request.method==='POST'&&originOk(Astro.request)){const f=await Astro.request.formData();try{upsertAuthor({id:Number(f.get('id'))||undefined,name:String(f.get('name')||'').trim(),slug:String(f.get('slug')||''),role_title:String(f.get('role_title')||''),bio:String(f.get('bio')||''),is_active:f.get('is_active')==='on'});message='Author saved.'}catch{error='Name and slug must be unique.'}}const authors=getAuthors(false);
---
<AdminLayout title="Authors" message={message} error={error}><div class="page-title"><div><h1>Authors & bylines</h1><p>People and desks shown on published work.</p></div></div><section class="panel"><h2>Add author</h2><form method="post" class="inline-form"><div class="field"><label>Name</label><input name="name" required></div><div class="field"><label>Slug</label><input name="slug"></div><div class="field"><label>Role</label><input name="role_title"></div><div class="field"><label>Bio</label><input name="bio"></div><label class="check"><input name="is_active" type="checkbox" checked> Active</label><button class="btn">Add</button></form></section><section class="panel"><h2>Existing authors</h2>{authors.map(a=><form method="post" class="inline-form" style="border-top:1px solid var(--line);padding:13px 0"><input type="hidden" name="id" value={a.id}><div class="field"><label>Name</label><input name="name" value={a.name}></div><div class="field"><label>Slug</label><input name="slug" value={a.slug}></div><div class="field"><label>Role</label><input name="role_title" value={a.role_title}></div><div class="field"><label>Bio</label><input name="bio" value={a.bio}></div><label class="check"><input name="is_active" type="checkbox" checked={a.is_active===1}> Active</label><button class="btn secondary">Save</button></form>)}</section></AdminLayout>
