---
import AdminLayout from '../../layouts/AdminLayout.astro'; import {getCategories,upsertCategory,deleteCategory} from '../../lib/queries'; import {originOk} from '../../lib/auth';
let message='',error='';if(Astro.request.method==='POST'&&originOk(Astro.request)){const f=await Astro.request.formData();const action=String(f.get('action'));if(action==='save'){try{upsertCategory({id:Number(f.get('id'))||undefined,name:String(f.get('name')||'').trim(),slug:String(f.get('slug')||''),description:String(f.get('description')||''),position:Number(f.get('position'))||0,is_active:f.get('is_active')==='on'});message='Category saved.'}catch{error='Name and slug must be unique.'}}else if(action==='delete'){const r=deleteCategory(Number(f.get('id')));if(r.ok)message='Category deleted.';else error=r.error||'Could not delete.'}}const categories=getCategories(false);
---
<AdminLayout title="Categories" message={message} error={error}><div class="page-title"><div><h1>Categories</h1><p>Public sections and navigation labels.</p></div></div><section class="panel"><h2>Add category</h2><form method="post" class="inline-form"><input type="hidden" name="action" value="save"><div class="field"><label>Name</label><input name="name" required></div><div class="field"><label>Slug</label><input name="slug" placeholder="auto from name"></div><div class="field"><label>Description</label><input name="description"></div><div class="field" style="max-width:80px"><label>Order</label><input name="position" type="number" value="20"></div><label class="check"><input name="is_active" type="checkbox" checked> Active</label><button class="btn">Add</button></form></section><section class="panel"><h2>Existing categories</h2>{categories.map(c=><form method="post" class="inline-form" style="border-top:1px solid var(--line);padding:13px 0"><input type="hidden" name="id" value={c.id}><div class="field"><label>Name</label><input name="name" value={c.name}></div><div class="field"><label>Slug</label><input name="slug" value={c.slug}></div><div class="field"><label>Description</label><input name="description" value={c.description}></div><div class="field" style="max-width:80px"><label>Order</label><input name="position" value={c.position} type="number"></div><label class="check"><input name="is_active" type="checkbox" checked={c.is_active===1}> Active</label><button class="btn secondary" name="action" value="save">Save</button><button class="btn danger" name="action" value="delete" formaction="/admin/categories" onclick="return confirm('Delete this category?')">Delete</button></form>)}</section></AdminLayout>
