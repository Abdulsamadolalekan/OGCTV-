---
import AdminLayout from '../../layouts/AdminLayout.astro'; import {getNewsroomStats,listArticlesAdmin,archiveAllSample} from '../../lib/queries'; import {originOk} from '../../lib/auth'; import {formatDateTime} from '../../lib/utils';
let message=Astro.url.searchParams.has('welcome')?'Newsroom created. Your credentials are stored securely.':''; let error=''; if(Astro.request.method==='POST'){if(!originOk(Astro.request))error='Request origin could not be verified.';else{const f=await Astro.request.formData();if(f.get('action')==='archive-sample'){const n=archiveAllSample();message=`Archived ${n} sample items.`}}}const stats=getNewsroomStats();const recent=listArticlesAdmin({}).slice(0,8);
---
<AdminLayout title="Overview" message={message} error={error}><div class="page-title"><div><h1>Newsroom overview</h1><p>A live view of OGCTV publishing.</p></div><a class="btn" href="/admin/articles/new">Create story</a></div><div class="stats"><div class="stat"><strong>{stats.published}</strong><span>Published</span></div><div class="stat"><strong>{stats.drafts}</strong><span>Drafts</span></div><div class="stat"><strong>{stats.breaking}</strong><span>Breaking now</span></div><div class="stat"><strong>{stats.videos}</strong><span>Videos</span></div></div><section class="panel"><h2>Recent work</h2><div class="table-wrap"><table><thead><tr><th>Headline</th><th>Status</th><th>Desk</th><th>Updated</th></tr></thead><tbody>{recent.map(a=><tr><td><a href={`/admin/articles/${a.id}`}>{a.title}</a>{a.is_sample===1&&' · Sample'}</td><td><span class={`status ${a.status}`}>{a.status}</span></td><td>{a.category_name}</td><td>{formatDateTime(a.updated_at)}</td></tr>)}</tbody></table></div></section><section class="panel"><h2>Launch checklist</h2><ul><li>Create the first administrator — complete.</li><li>Replace or archive all content labelled “Sample”.</li><li>Set <code>PUBLIC_SITE_URL</code> to the confirmed canonical production origin.</li><li>Put the <code>data/</code> directory on persistent storage and back it up.</li><li>Connect only real YouTube/Vimeo videos or a verified stream.</li></ul>{stats.sample>0&&<form method="post" onsubmit="return confirm('Archive all sample content?')"><input type="hidden" name="action" value="archive-sample"><button class="btn danger">Archive all {stats.sample} sample items</button></form>}</section></AdminLayout>
