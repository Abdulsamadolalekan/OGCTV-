---
import AdminLayout from '../../layouts/AdminLayout.astro'; import { SITE } from '../../lib/config'; import {login,clientIp,originOk,getSessionUser} from '../../lib/auth';
if(getSessionUser(Astro.request,Astro.cookies)) return Astro.redirect('/admin',303); let error=''; const next=Astro.url.searchParams.get('next')||'/admin'; const safeNext=next.startsWith('/admin')&&!next.startsWith('//')?next:'/admin'; if(Astro.request.method==='POST'){if(!originOk(Astro.request))error='Request origin could not be verified.';else{const f=await Astro.request.formData();const result=await login(Astro.cookies,String(f.get('email')||''),String(f.get('password')||''),clientIp(Astro.request));if(result.ok)return Astro.redirect(safeNext,303);error=result.error}}
---
<AdminLayout title="Newsroom sign in" error={error}><div class="auth-card"><div class="logo"><img src={SITE.logo} width={SITE.logoWidth} height={SITE.logoHeight} alt={`${SITE.name} Newsroom`} /></div><h1>Welcome back</h1><p>Authorised staff only. Public visitors cannot reach newsroom tools.</p><form method="post"><div class="field"><label for="email">Email</label><input id="email" name="email" type="email" required autocomplete="email"/></div><div class="field"><label for="password">Password</label><input id="password" name="password" type="password" required autocomplete="current-password"/></div><button class="btn">Sign in</button></form><p style="margin-top:25px"><a href="/">← Back to OGCTV</a></p></div></AdminLayout>
