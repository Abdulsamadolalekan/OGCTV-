---
import AdminLayout from '../../layouts/AdminLayout.astro'; import {listMedia,saveUpload,deleteMedia,updateMediaMeta} from '../../lib/media'; import {originOk} from '../../lib/auth';
let message='',error='';if(Astro.request.method==='POST'&&originOk(Astro.request)){const f=await Astro.request.formData();const action=String(f.get('action'));if(action==='upload'){const file=f.get('file');if(file instanceof File){const r=await saveUpload({buffer:Buffer.from(await file.arrayBuffer()),type:file.type,name:file.name},{alt:String(f.get('alt')||''),caption:String(f.get('caption')||''),credit:String(f.get('credit')||'')});if(r.ok)message=`Uploaded ${r.item.filename}`;else error=r.error}else error='Choose an image.'}else if(action==='delete'){const r=deleteMedia(Number(f.get('id')));if(r.ok)message='Media deleted.';else error=r.error||'Could not delete.'}else if(action==='update'){updateMediaMeta(Number(f.get('id')),{alt:String(f.get('alt')||''),caption:String(f.get('caption')||''),credit:String(f.get('credit')||'')});message='Media details updated.'}}const items=listMedia();
---
<AdminLayout title="Media" message={message} error={error}><div class="page-title"><div><h1>Media library</h1><p>Upload, optimise and reuse newsroom images.</p></div></div><section class="panel"><h2>Upload image</h2><form method="post" enctype="multipart/form-data"><input type="hidden" name="action" value="upload"><div class="editor-grid"><div><div class="field"><label for="file">JPG, PNG, WebP or GIF (max 12 MB)</label><input id="file" name="file" type="file" accept="image/jpeg,image/png,image/webp,image/gif" required></div><div class="field"><label>Alt text</label><input name="alt" maxlength="300" placeholder="Describe what is visible"></div></div><div><div class="field"><label>Caption</label><input name="caption"></div><div class="field"><label>Credit</label><input name="credit"></div></div></div><button class="btn">Upload & optimise</button></form></section>{items.length?<div class="media-grid" style="margin-top:20px">{items.map(m=><article class="media-card"><img src={m.path} alt={m.alt}><div><strong>{m.filename}</strong><br><code>{m.path}</code><br>{m.width}×{m.height} · {Math.round(m.size/1024)} KB<form method="post" style="margin-top:9px"><input type="hidden" name="id" value={m.id}><input type="hidden" name="action" value="delete"><button class="btn danger" onclick="return confirm('Delete this media item?')">Delete</button></form></div></article>)}</div>:<div class="panel"><p>No uploaded media yet. Seed illustrations live in <code>public/seed-media</code> and are not part of the permanent media library.</p></div>}</AdminLayout>
