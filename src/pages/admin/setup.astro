---
import AdminLayout from '../../layouts/AdminLayout.astro'; import { SITE } from '../../lib/config'; import {createFirstAdmin,login,clientIp,originOk} from '../../lib/auth';
let error=''; if(Astro.request.method==='POST'){if(!originOk(Astro.request)){error='Request origin could not be verified.'}else{const f=await Astro.request.formData();const name=String(f.get('name')||'').trim();const email=String(f.get('email')||'').trim();const password=String(f.get('password')||'');const confirm=String(f.get('confirm')||'');if(name.length<2)error='Enter the administrator’s name.';else if(!/^\S+@\S+\.\S+$/.test(email))error='Enter a valid email address.';else if(password.length<12)error='Use at least 12 characters for the password.';else if(password!==confirm)error='Passwords do not match.';else try{await createFirstAdmin({name,email,password});await login(Astro.cookies,email,password,clientIp(Astro.request));return Astro.redirect('/admin?welcome=1',303)}catch(e){error=e instanceof Error?e.message:'Setup failed.'}}}
---
<AdminLayout title="Set up newsroom" error={error}><div class="auth-card"><div class="logo"><img src={SITE.logo} width={SITE.logoWidth} height={SITE.logoHeight} alt={`${SITE.name} Newsroom`} /></div><h1>Create the first administrator</h1><p>This one-time setup stores a scrypt-hashed password in the local database. No default credentials exist.</p><form method="post"><div class="field"><label for="name">Your name</label><input id="name" name="name" required autocomplete="name"/></div><div class="field"><label for="email">Work email</label><input id="email" name="email" type="email" required autocomplete="email"/></div><div class="field"><label for="password">Password</label><input id="password" name="password" type="password" minlength="12" required autocomplete="new-password"/><small>At least 12 characters. Use a password manager.</small></div><div class="field"><label for="confirm">Confirm password</label><input id="confirm" name="confirm" type="password" required autocomplete="new-password"/></div><button class="btn" type="submit">Create secure newsroom</button></form></div></AdminLayout>
