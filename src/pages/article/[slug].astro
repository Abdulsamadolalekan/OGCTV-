---
import SiteLayout from '../../layouts/SiteLayout.astro'; import StoryRow from '../../components/StoryRow.astro'; import SectionHead from '../../components/SectionHead.astro'; import {getPublishedArticle,getRelatedArticles,getMoreFromCategory} from '../../lib/queries'; import {renderMarkdown} from '../../lib/markdown'; import {SITE} from '../../lib/config'; import {formatDateTime,readingTime,parseTags} from '../../lib/utils';
const article=getPublishedArticle(Astro.params.slug!); if(!article||article.kind==='video') Astro.response.status=404; const related=article?getRelatedArticles(article,3):[]; const more=article?getMoreFromCategory(article,4,related.map(x=>x.id)):[]; const url=article?`${SITE.url}/article/${article.slug}`:''; const shareText=article?`${article.title} — OGCTV`:''; const jsonLd=article?{'@context':'https://schema.org','@type':'NewsArticle',headline:article.title,description:article.deck,image:article.image?[new URL(article.image,SITE.url).toString()]:undefined,datePublished:article.published_at,dateModified:article.updated_at,author:{'@type':'Organization',name:article.author_name},publisher:{'@type':'NewsMediaOrganization',name:'OGCTV',url:SITE.url,logo:{'@type':'ImageObject',url:new URL(SITE.logo,SITE.url).toString(),width:SITE.logoWidth,height:SITE.logoHeight}},mainEntityOfPage:url,articleSection:article.category_name}:undefined;
---
{article&&article.kind==='story'?<SiteLayout title={article.title} description={article.deck} image={article.image} canonical={url} type="article" published={article.published_at} updated={article.updated_at} jsonLd={jsonLd}><article class="article-page"><div class="container"><nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/">Home</a> / <a href={`/category/${article.category_slug}`}>{article.category_name}</a> / <span aria-current="page">Story</span></nav><header class="article-head"><div class="story-kicker">{article.category_name} {article.is_sample===1&&<span class="sample-label">Sample content</span>}</div><h1>{article.title}</h1>{article.deck&&<p class="article-deck">{article.deck}</p>}<div class="byline">By <a href={`/author/${article.author_slug}`}>{article.author_name}</a></div><div class="meta"><span><time datetime={article.published_at!}>{formatDateTime(article.published_at!)}</time> WAT</span>{article.updated_at!==article.published_at&&<span>Updated {formatDateTime(article.updated_at)} WAT</span>}<span>{readingTime(article.body)} min read</span></div></header>{article.image&&<figure class="article-hero"><img src={article.image} alt={article.image_alt} width="1200" height="675" />{(article.image_caption||article.image_credit)&&<figcaption class="caption">{article.image_caption} {article.image_credit&&<span>— {article.image_credit}</span>}</figcaption>}</figure>}<div class="article-layout"><aside class="share-rail"><h2>Share this story</h2><div class="share-links"><a href={`https://wa.me/?text=${encodeURIComponent(`${shareText} ${url}`)}`} target="_blank" rel="noopener">WhatsApp</a><a href={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(url)}`} target="_blank" rel="noopener">Facebook</a><a href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(shareText)}&url=${encodeURIComponent(url)}`} target="_blank" rel="noopener">X</a><button class="copy-btn" data-copy={url}>Copy link</button></div></aside><div>{article.is_sample===1&&<div class="story-note"><strong>Demonstration story:</strong> This page shows the complete OGCTV article experience. It is not a report of a current event.</div>}<div class="article-body" set:html={renderMarkdown(article.body)} />{parseTags(article.tags).length>0&&<div class="tags" aria-label="Topics">{parseTags(article.tags).map(t=><a href={`/search?q=${encodeURIComponent(t)}`}>{t}</a>)}</div>}</div><aside class="article-aside"><h2>Related stories</h2>{related.map(a=><article><div class="story-kicker">{a.category_name}</div><h3><a href={`/article/${a.slug}`}>{a.title}</a></h3></article>)}</aside></div></div></article>{more.length>0&&<section class="section category-band"><div class="container"><SectionHead title={`More from ${article.category_name}`} href={`/category/${article.category_slug}`}/>{more.map(a=><StoryRow article={a}/>)}</div></section>}</SiteLayout>:<SiteLayout title="Story not found" noindex><div class="narrow empty"><h1>Story not found</h1><p>The story may have moved, or it may not have been published.</p><a class="button" href="/latest">Read latest news</a></div></SiteLayout>}
