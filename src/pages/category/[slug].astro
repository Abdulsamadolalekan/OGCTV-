---
import SiteLayout from '../../layouts/SiteLayout.astro'; import StoryRow from '../../components/StoryRow.astro'; import Pagination from '../../components/Pagination.astro'; import {getCategoryBySlug,listPublished,getTrending} from '../../lib/queries';
const {slug}=Astro.params; const category=getCategoryBySlug(slug!); if(!category){Astro.response.status=404;} const page=Math.max(1,Number(Astro.url.searchParams.get('page'))||1); const result=category?listPublished({categorySlug:category.slug,page,perPage:10}):null; const trending=getTrending(4);
---
{category&&result?<SiteLayout title={category.name} description={category.description}><header class="page-head"><div class="container"><div class="eyebrow">OGCTV desk</div><h1>{category.name}</h1><p>{category.description}</p></div></header><div class="container listing"><div>{result.items.length?result.items.map(a=><StoryRow article={a}/>):<div class="empty">No published stories in this section yet.</div>}<Pagination page={result.page} pages={result.pages} base={`/category/${category.slug}?`}/></div><aside class="trending"><h2>Trending across OGCTV</h2>{trending.map((a,i)=><article class="trend-item"><span class="trend-num">{i+1}</span><h3><a href={a.kind==='video'?`/tv/${a.slug}`:`/article/${a.slug}`}>{a.title}</a></h3></article>)}</aside></div></SiteLayout>:<SiteLayout title="Section not found" noindex><div class="narrow empty"><h1>Section not found</h1><p>This section does not exist or is no longer available.</p><a class="button" href="/">Return home</a></div></SiteLayout>}
