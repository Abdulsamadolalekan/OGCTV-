---
import SiteLayout from '../layouts/SiteLayout.astro'; import BreakingBar from '../components/BreakingBar.astro'; import StoryRow from '../components/StoryRow.astro'; import SectionHead from '../components/SectionHead.astro';
import { getLeadStory,getSecondaryStories,listPublished,getTrending,getCategoryBand,getFeaturedVideo } from '../lib/queries'; import { formatDate,readingTime } from '../lib/utils';
const storyHref=(item:{kind:string;slug:string})=>item.kind==='video'?`/tv/${item.slug}`:`/article/${item.slug}`; const lead=getLeadStory(); const secondary=getSecondaryStories(lead?[lead.id]:[],2); const used=[lead?.id,...secondary.map(x=>x.id)].filter(Boolean) as number[]; const latest=listPublished({kind:'story',excludeIds:used,perPage:6}).items; const trending=getTrending(5); const community=getCategoryBand('community',3); const business=getCategoryBand('business',3); const video=getFeaturedVideo(); const videos=listPublished({kind:'video',excludeIds:video?[video.id]:[],perPage:3}).items;
---
<SiteLayout><BreakingBar />{lead?<>
<section class="hero"><div class="container hero-grid"><div><a href={`/article/${lead.slug}`} class="lead-image"><img src={lead.image!} alt={lead.image_alt} width="1000" height="563" fetchpriority="high" /></a><div class="lead-copy"><div class="story-kicker">{lead.category_name} <span class="sample-label">Sample</span></div><h1 class="lead-title"><a href={`/article/${lead.slug}`}>{lead.title}</a></h1><p class="lead-deck">{lead.deck}</p><div class="meta"><span>By {lead.author_name}</span><span>{formatDate(lead.published_at!)}</span><span>{readingTime(lead.body)} min read</span></div></div></div><aside class="side-leads" aria-label="Top stories">{secondary.map(s=><article class="side-story">{s.image&&<a href={`/article/${s.slug}`}><img src={s.image} alt={s.image_alt} /></a>}<div><div class="story-kicker">{s.category_name} <span class="sample-label">Sample</span></div><h2><a href={`/article/${s.slug}`}>{s.title}</a></h2><p>{s.deck}</p><div class="meta"><span>{formatDate(s.published_at!)}</span></div></div></article>)}</aside></div></section>
<section class="section"><div class="container"><SectionHead title="Latest news" href="/latest"/><div class="latest-grid"><div>{latest.map(a=><StoryRow article={a}/>)}</div><aside class="trending"><h2>Trending now</h2>{trending.map((a,i)=><article class="trend-item"><span class="trend-num">{String(i+1).padStart(2,'0')}</span><div><div class="story-kicker">{a.category_name}</div><h3><a href={a.kind==='video'?`/tv/${a.slug}`:`/article/${a.slug}`}>{a.title}</a></h3></div></article>)}</aside></div></div></section>
{community?.top&&<section class="section category-band"><div class="container"><SectionHead title="Community" href="/category/community"/><div class="band-grid"><article class="band-lead">{community.top.image&&<img src={community.top.image} alt={community.top.image_alt}/>}<div class="story-kicker">Community <span class="sample-label">Sample</span></div><h3><a href={storyHref(community.top)}>{community.top.title}</a></h3><p class="serif muted">{community.top.deck}</p></article><div class="band-list">{community.list.map(a=><article><div class="story-kicker">{a.category_name}</div><h3><a href={storyHref(a)}>{a.title}</a></h3><div class="meta"><span>{formatDate(a.published_at!)}</span></div></article>)}</div></div></div></section>}
{video&&<section class="section video-band"><div class="container"><SectionHead title="OGCTV TV" href="/tv" label="Watch all"/><div class="video-grid"><article class="video-feature"><a href={`/tv/${video.slug}`}><img src={video.image!} alt={video.image_alt}/><span class="play" aria-hidden="true"></span></a><div class="eyebrow">Featured video · {video.video_duration}</div><h3><a href={`/tv/${video.slug}`}>{video.title}</a></h3><p>{video.deck}</p></article><div class="video-list">{videos.map(v=><article><a href={`/tv/${v.slug}`}><img src={v.image!} alt={v.image_alt}/></a><div><div class="eyebrow">{v.programme.replaceAll('-',' ')}</div><h3><a href={`/tv/${v.slug}`}>{v.title}</a></h3><span class="meta">{v.video_duration}</span></div></article>)}</div></div></div></section>}
{business?.top&&<section class="section"><div class="container"><SectionHead title="Business & economy" href="/category/business"/><div class="band-grid"><article class="band-lead">{business.top.image&&<img src={business.top.image} alt={business.top.image_alt}/>}<div class="story-kicker">Business</div><h3><a href={`/article/${business.top.slug}`}>{business.top.title}</a></h3></article><div>{business.list.map(a=><StoryRow article={a} image={false}/>)}</div></div></div></section>}</>:<section class="narrow empty"><h1>OGCTV newsroom</h1><p>No published stories yet. Editors can publish the first story from the protected newsroom.</p></section>}</SiteLayout>
