---
import SiteLayout from '../layouts/SiteLayout.astro'; import {searchArticles} from '../lib/queries'; import {formatDate} from '../lib/utils';
const q=(Astro.url.searchParams.get('q')||'').trim().slice(0,100); const page=Math.max(1,Number(Astro.url.searchParams.get('page'))||1); const result=q?searchArticles(q,page,15):null;
---
<SiteLayout title={q?`Search results for “${q}”`:'Search'} description="Search OGCTV articles, headlines, categories and authors." noindex={!!q}><header class="page-head"><div class="container"><div class="eyebrow">Find a story</div><h1>Search OGCTV</h1><form class="search-form" action="/search" method="get" role="search"><label class="skip-link" for="q">Search terms</label><input id="q" name="q" value={q} placeholder="Try “education”, “business” or an author…" maxlength="100" required autofocus/><button>Search</button></form></div></header><div class="narrow section">{q&&<p class="eyebrow">{result?.hits.length||0}{result&&result.total>result.hits.length?' or more':''} result(s) for “{q}”</p>}{result?.hits.length?result.hits.map(h=><article class="search-hit"><div class="story-kicker">{h.article.category_name} · {h.article.kind}</div><h2><a href={h.article.kind==='video'?`/tv/${h.article.slug}`:`/article/${h.article.slug}`} set:html={h.titleHtml}/></h2><p set:html={h.snippetHtml||h.article.deck}/><div class="meta"><span>{h.article.author_name}</span><span>{formatDate(h.article.published_at!)}</span></div></article>):q?<div class="empty"><strong>No matching stories.</strong><p>Check the spelling, use fewer words, or browse the latest news.</p><a class="button" href="/latest">Latest news</a></div>:<div class="empty"><p>Search headlines, article text, categories, bylines and topics.</p></div>}</div></SiteLayout>
