---
import SiteLayout from '../../layouts/SiteLayout.astro'; import StoryRow from '../../components/StoryRow.astro'; import SectionHead from '../../components/SectionHead.astro'; import {getPublishedArticle,getRelatedVideos} from '../../lib/queries'; import {renderMarkdown} from '../../lib/markdown'; import {videoEmbed,formatDateTime} from '../../lib/utils'; import {SITE} from '../../lib/config';
const video=getPublishedArticle(Astro.params.slug!); if(!video||video.kind!=='video') Astro.response.status=404; const embed=video?.video_url?videoEmbed(video.video_url):null; const related=video?getRelatedVideos(video,4):[]; const url=video?`${SITE.url}/tv/${video.slug}`:'';
---
{video&&video.kind==='video'?<SiteLayout title={video.title} description={video.deck} image={video.image} type="video.other" canonical={url}><article class="article-page"><div class="container"><nav class="breadcrumbs"><a href="/">Home</a> / <a href="/tv">OGCTV TV</a> / Video</nav><header class="article-head"><div class="story-kicker">{video.programme.replaceAll('-',' ')} {video.is_sample===1&&<span class="sample-label">Sample</span>}</div><h1>{video.title}</h1><p class="article-deck">{video.deck}</p><div class="meta"><span>By {video.author_name}</span><span>{formatDateTime(video.published_at!)} WAT</span><span>{video.video_duration||'Video'}</span></div></header><div class="video-player">{embed?<iframe src={embed.src} title={video.title} loading="eager" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>:<div class="video-placeholder"><div class="play" style="position:static;margin:0 auto 20px"></div><h2>Video not connected yet</h2><p>{video.is_sample?'This demonstration entry shows the finished video-page layout. No fake player or livestream is presented.':'The newsroom is preparing this video. Check back soon.'}</p></div>}</div><div class="article-layout"><aside class="share-rail"><h2>Share</h2><div class="share-links"><a href={`https://wa.me/?text=${encodeURIComponent(`${video.title} — OGCTV ${url}`)}`} target="_blank" rel="noopener">WhatsApp</a><button class="copy-btn" data-copy={url}>Copy link</button></div></aside><div>{video.is_sample===1&&<div class="story-note"><strong>Demonstration video:</strong> This is sample programme content, not footage of a current event.</div>}<div class="article-body" set:html={renderMarkdown(video.body)}/></div></div></div></article>{related.length>0&&<section class="section category-band"><div class="container"><SectionHead title="Watch next" href="/tv"/>{related.map(v=><StoryRow article={v}/>)}</div></section>}</SiteLayout>:<SiteLayout title="Video not found" noindex><div class="narrow empty"><h1>Video not found</h1><a class="button" href="/tv">Go to OGCTV TV</a></div></SiteLayout>}
