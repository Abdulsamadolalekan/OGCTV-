---
import SiteLayout from '../../layouts/SiteLayout.astro'; import StoryRow from '../../components/StoryRow.astro'; import SectionHead from '../../components/SectionHead.astro'; import {getFeaturedVideo,listPublished,PROGRAMMES,getProgrammeCounts} from '../../lib/queries';
const programme=Astro.url.searchParams.get('programme')||undefined; const featured=getFeaturedVideo(); const result=listPublished({kind:'video',programme,excludeIds:!programme&&featured?[featured.id]:[],perPage:20}); const counts=getProgrammeCounts(); const selected=PROGRAMMES.find(p=>p.slug===programme);
---
<SiteLayout title={selected?`${selected.name} — OGCTV TV`:'OGCTV TV'} description="Original video reports, interviews, news clips and programmes from OGCTV."><header class="page-head" style="background:var(--green);color:#fff"><div class="container"><div class="eyebrow" style="color:#e6c66e">Watch · Listen · Understand</div><h1>OGCTV TV</h1><p style="color:#c9d7d1">Original reporting, interviews and programmes from Ogun’s digital voice. No stream is shown unless a real OGCTV feed is connected.</p></div></header>{featured&&!programme&&<section class="section video-band"><div class="container"><SectionHead title="Featured video"/><div class="video-grid"><article class="video-feature"><a href={`/tv/${featured.slug}`}><img src={featured.image!} alt={featured.image_alt}/><span class="play"></span></a><div class="eyebrow">{featured.programme.replaceAll('-',' ')} · {featured.video_duration}</div><h3><a href={`/tv/${featured.slug}`}>{featured.title}</a></h3><p>{featured.deck}</p></article><div><h2 class="serif">Video, ready for real infrastructure</h2><p>This player architecture accepts YouTube or Vimeo embeds now and can connect to a real livestream later. Demonstration videos do not pretend to be playable.</p><a class="button" style="background:#fff;color:var(--ink)" href="/contact">Talk to the newsroom</a></div></div></div></section>}<section class="section"><div class="container"><SectionHead title="Programmes"/><div style="display:flex;gap:10px;flex-wrap:wrap">{PROGRAMMES.map(p=><a class="button secondary" href={`/tv?programme=${p.slug}`} aria-current={programme===p.slug?'page':undefined}>{p.name} ({counts.get(p.slug)||0})</a>)}</div></div></section><section class="section category-band"><div class="container"><SectionHead title={selected?selected.name:'Latest videos'} href={programme?'/tv':undefined} label="All videos"/><div class="latest-grid"><div>{result.items.length?result.items.map(v=><StoryRow article={v}/>):<p class="empty">No videos in this programme yet.</p>}</div><aside class="trending"><h2>About OGCTV TV</h2><p class="serif">Field reports, news clips and conversations designed for mobile viewing. Video entries can be published before the final player is connected, with a clear availability message.</p></aside></div></div></section></SiteLayout>
